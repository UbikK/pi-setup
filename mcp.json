{
  "mcpServers": {
    "engram": {
      "args": [
        "mcp",
        "--tools=agent"
      ],
      "command": "/opt/homebrew/bin/engram",
      "directTools": false,
      "lifecycle": "lazy"
    },
    "npm-registry": {
      "command": "npx",
      "args": [
        "mcp-npm-registry"
      ]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "description": "Search and work with GitHub repositories, issues, pull requests, and code.",
      "exposure": "deferred"
    }
  }
}
